<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="This is the activity for express session visitor">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <title>Express Visitor</title>
</head>
<body>
    <div class="container w-50 mx-auto text-center my-5 row">
        <h1>You are Visitor #<%= data.num %></h1>
        <h2><%= data.quote %></h2>
        <form class="col-6 text-center" action="reset" method="post">
            <input class="btn btn-success" type="submit" name="submit" value="Reset">
        </form>
        <form class="col-6 text-center" action="repeat" method="post">
            <input class="btn btn-success" type="submit" name="submit" value="Repeat">
        </form>
    </div>
</body>
</html>